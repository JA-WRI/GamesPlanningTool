generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  Admin
  COC
  NSO
}

enum MemberType {
  Athlete
  Staff
}

enum UserStatus {
  invited
  active
  inactive
}

model Game {
  id                  Int      @id @default(autoincrement())
  name                String
  country             String
  city                String
  startDate           DateTime @map("start_date") @db.Date
  endDate             DateTime @map("end_date") @db.Date
  planningPeriodStart DateTime @map("planning_period_start")
  planningPeriodEnd   DateTime @map("planning_period_end")
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now())

  gameNsos    GameNso[]
  gameMembers GameMember[]
  travelers   Traveler[]
  
  @@map("games")
}

model Nso {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  sport     String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  users    User[]
  members  Member[]
  gameNsos GameNso[]
  travelers Traveler[]

  @@map("nsos")
}

model GameNso {
  id     String @id @default(uuid()) @db.Uuid
  gameId Int    @map("game_id")
  nsoId  String @map("nso_id") @db.Uuid

  game Game @relation(fields: [gameId], references: [id])
  nso  Nso  @relation(fields: [nsoId], references: [id])

  @@unique([gameId, nsoId])
  @@index([nsoId])
  @@map("game_nsos")
}

model User {
  id        String     @id @default(uuid()) @db.Uuid
  email     String     @unique
  firstName String     @map("first_name")
  lastName  String     @map("last_name")
  nsoId     String?    @map("nso_id") @db.Uuid
  role      Role
  status    UserStatus @default(invited)
  createdAt DateTime   @default(now()) @map("created_at")

  nso Nso? @relation(fields: [nsoId], references: [id])

  @@index([nsoId])
  @@map("users")
}

// Staff and athletes (one row per person, across all games)
model Member {
  id         String     @id @default(uuid()) @db.Uuid
  firstName  String     @map("first_name")
  lastName   String     @map("last_name")
  gender     String
  type       MemberType
  discipline String?
  nsoId      String     @map("nso_id") @db.Uuid

  nso         Nso          @relation(fields: [nsoId], references: [id])
  gameMembers GameMember[]

  @@index([nsoId])
  @@map("members")
}

// A member's participation in one game
model GameMember {
  id               String    @id @default(uuid()) @db.Uuid
  gameId           Int       @map("game_id")
  memberId         String    @map("member_id") @db.Uuid

  // Shared by staff and athletes
  fundedBy         String?   @map("funded_by")
  clothing         String?
  outfittingBag    String?   @map("outfitting_bag")
  requestRoomNotes String?   @map("request_room_notes")
  gameArrival      DateTime? @map("game_arrival") @db.Date
  gameDeparture    DateTime? @map("game_departure") @db.Date

  // Staff only
  gamesRole        String?   @map("games_role")
  rank             String?

  // Athletes only
  event            String?
  medal            String?
  medalNotes       String?   @map("medal_notes")

  game   Game   @relation(fields: [gameId], references: [id])
  member Member @relation(fields: [memberId], references: [id])

  @@unique([gameId, memberId])
  @@index([memberId])
  @@map("game_members")
}


model Resource {
  id String @id @default(uuid()) @db.Uuid

  parentFolderId String? @map("parent_folder_id") @db.Uuid
  parent Resource? @relation("ParentElement", fields: [parentFolderId], references: [id])
  children Resource[] @relation("ParentElement")

  name String
  fileOrWebpageURL String? @map("file_or_webpage_URL") // null: folder
  isWebpage Boolean @map("is_webpage") @default(false)
  categories String[] @default([])

  previousElementId String? @map("previous_element_id") @db.Uuid
  previous Resource? @relation("PreviousElement", fields: [previousElementId], references: [id])
  nextFromPrevious Resource[] @relation("PreviousElement")

  nextElementId String? @map("next_element_id") @db.Uuid
  next Resource? @relation("NextElement", fields: [nextElementId], references: [id])
  previousFromNext Resource[] @relation("NextElement")

  @@map("resources")
}

// Calculator tables 
model Traveler {
  id                 Int       @id @default(autoincrement())
  travelerCategoryId Int       @map("traveler_category_id")
  gameId             Int       @map("games_id")
  nsoId              String    @map("nso_id") @db.Uuid

  numberOfTeamMembers Int       @default(0) @map("number_of_team_members")
  days                Int       @default(0)
  checkInDate         DateTime? @map("check_in_date") @db.Date
  checkOutDate        DateTime? @map("check_out_date") @db.Date

  travelCostInCents        Int @default(0) @map("travel_cost_in_cents")
  accommodationCostInCents Int @default(0) @map("accommodation_cost_in_cents")
  mealsCostInCents         Int @default(0) @map("meals_cost_in_cents")
  insuranceCostInCents     Int @default(0) @map("insurance_cost_in_cents")
  extraCostsInCents        Int @default(0) @map("extra_costs_in_cents")

  travelerCategory TravelerCategory @relation(fields: [travelerCategoryId], references: [id])
  game             Game             @relation(fields: [gameId], references: [id])
  nso              Nso              @relation(fields: [nsoId], references: [id])

  @@index([gameId, nsoId])
  @@index([travelerCategoryId])
  @@map("traveler")
}
  

model TravelerCategory {
  id Int @id @default(autoincrement())
  name String @unique
  travelers Traveler[]
  estimatesCostItems EstimatedCostItem[]
  @@map("traveler_category")
}

model EstimatedCostItem {
  id                 Int     @id @default(autoincrement())
  name               String
  costInCents        Int     @default(0) @map("cost_in_cents")
  unitOfMeasure      String  @map("unit_of_measure")
  notes              String?
  isCoveredByCOC     Boolean @default(false) @map("is_covered_by_COC")
  travelerCategoryId Int?    @map("traveler_category_id")

  travelerCategory TravelerCategory? @relation(fields: [travelerCategoryId], references: [id])

  @@index([travelerCategoryId])
  @@map("estimated_cost_items")
}

model ConversionRate {
  id           Int      @id @default(autoincrement())
  fromCurrency String   @map("from_currency")
  toCurrency   String   @map("to_currency")
  rate         Decimal  @db.Decimal(18, 8)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([fromCurrency, toCurrency])
  @@map("conversion_rates")
}